# Device-level kernel fragment. [kernel] config_fragments merges arch -> soc -> os -> device, so this
# file is the last word: the profile fragments above it enable the offline mockfs fixture and name
# their own link inputs, and a value written in the defconfig does not win against them.
#
# 2026-11-14: the mockfs fixture is switched off here rather than in the defconfig.
# build-xnu-4k-baseline.sh compiles vfs_conf.o with -DMOCKFS=$MOCKFS_MODE and only force-loads
# build/mockfs-fixture/libmockfs_fixture.a when that mode is 1; leaving it on without the fixture
# produced the three undefined symbols (_mockfs_mountroot, _mockfs_vfsops,
# _mockfs_vnodeop_opv_desc) that blocked the UFS link. A UFS root does not need the fixture, and
# alioth's stage-2 configuration does not carry it either.
CONFIG_XNU_SOURCE_MOCKFS=n
CONFIG_XNU_NATIVE_RAM_BLOCK=n

# The offline-legacy probe hooks (NativeLegacyDisplay is not selected) come from this archive only.
# It must carry -force_load: build-xnu-4k-baseline.sh appends this string verbatim to the link line
# (scripts/build-xnu-4k-baseline.sh:838), and a plain archive there does not satisfy references the
# kernel objects already made — 2026-11-14 the link still died on all three hooks with the bare path.
CONFIG_XNU_EXTRA_LD_ARCHIVES="-Wl,-force_load,{tree}/build/link-stubs/libLinkStubs.a"

# Stage 2 target for this board.
CONFIG_XNU_NATIVE_UFS=y
